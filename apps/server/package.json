{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "DOTENV_CONFIG_PATH=.env.test vp test",
    "db:seed": "bun run src/db/seed.ts",
    "db:assign-admin": "bun run src/db/assign-admin.ts"
  },
  "dependencies": {
    "@better-t-stack-template/auth": "workspace:*",
    "@better-t-stack-template/db": "workspace:*",
    "@better-t-stack-template/env": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.11.8",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.1",
    "jose": "6.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stoker": "^2.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-t-stack-template/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:",
    "vitest": "^0.1.24"
  }
}
