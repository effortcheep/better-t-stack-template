# 复制为 apps/server/.env 并填写实际值
# Web 端: apps/web/.env 仅需 VITE_SERVER_URL

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better_t_stack

# Redis
REDIS_URL=redis://localhost:6379

# Auth (min 32 chars)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_SECRET=change-me-to-another-random-string-32chars
BETTER_AUTH_URL=http://localhost:3000

# CORS — must match web dev server origin
CORS_ORIGIN=http://localhost:3001

# Web (apps/web/.env)
# VITE_SERVER_URL=http://localhost:3000

# Test overrides (apps/server/.env.test)
# NODE_ENV=test
# DOTENV_CONFIG_PATH=.env.test
