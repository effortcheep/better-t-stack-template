import { createFileRoute } from "@tanstack/react-router"
import { requirePermission } from "@/lib/route-guard"

import Update<%= Singular %>Page from "@/features/<%= name %>/pages/$<%= singular %>Id/update"

export const Route = createFileRoute(
  "/_authenticated/<%= name %>/$<%= singular %>Id/update",
)({
  beforeLoad: () => {
    requirePermission("<%= name %>:update")
  },
  staticData: { breadcrumbs: [{ label: "<%= title %>管理", href: "/<%= name %>" }, { label: "编辑" }] },
  component: RouteComponent,
})

function RouteComponent() {
  const { <%= singular %>Id } = Route.useParams()
  return <Update<%= Singular %>Page <%= singular %>Id={<%= singular %>Id} />
}
