"use client"

import { Button } from "@better-t-stack-template/ui/components/button"
import {
  Field,
  FieldContent,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@better-t-stack-template/ui/components/field"
import { Input } from "@better-t-stack-template/ui/components/input"<% if (fields.some((f) => f.type === "boolean")) { %>
import { Switch } from "@better-t-stack-template/ui/components/switch"<% } %>
import { useForm } from "@tanstack/react-form"
import { useEffect } from "react"

import type { <%= Singular %>Record } from "@/features/<%= name %>/types"

/** 创建/更新输入类型（业务字段） */
type <%= Singular %>Input = {<% fields.forEach((f) => { %>
  <%= f.name %>: <%= f.type === "text" ? "string" : f.type === "boolean" ? "boolean" : f.type === "number" ? "number" : "string" %><% }) %>
}

interface <%= Singular %>FormProps {
  defaultValues?: <%= Singular %>Record
  onSubmit: (values: <%= Singular %>Input) => void | Promise<void>
  isPending?: boolean
  onDirtyChange?: (dirty: boolean) => void
  onCancel?: () => void
}

export function <%= Singular %>Form({
  defaultValues,
  onSubmit: onSubmitProp,
  isPending,
  onDirtyChange,
  onCancel,
}: <%= Singular %>FormProps) {
  const form = useForm({
    defaultValues: {<% fields.forEach((f) => { %>
      <%= f.name %>: <% if (f.type === "text") { %>defaultValues?.<%= f.name %> ?? ""<% } else if (f.type === "boolean") { %>defaultValues?.<%= f.name %> ?? false<% } else if (f.type === "number") { %>defaultValues?.<%= f.name %> ?? 0<% } else { %>defaultValues?.<%= f.name %> ? new Date(defaultValues.<%= f.name %>).toISOString().slice(0, 10) : ""<% } %>,<% }) %>
    },
    onSubmit: ({ value }) => {
      onSubmitProp(value)
    },
  })

  // 未保存变更时阻止意外关闭/刷新
  useEffect(() => {
    if (!form.state.isDirty) return
    const handler = (e: BeforeUnloadEvent) => {
      e.preventDefault()
      e.returnValue = ""
    }
    window.addEventListener("beforeunload", handler)
    return () => window.removeEventListener("beforeunload", handler)
  }, [form.state.isDirty])

  // 表单变更状态通知父组件
  useEffect(() => {
    onDirtyChange?.(form.state.isDirty)
  }, [form.state.isDirty])

  const handleReset = () => {
    form.reset()
  }

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault()
        e.stopPropagation()
        form.handleSubmit()
      }}
      className="flex flex-col gap-4"
    >
      <FieldGroup>
        <div className="grid gap-4">
          <% fields.forEach((f) => { %><% if (f.type === "text") { %>
          <form.Field
            name="<%= f.name %>"
            validators={{
              onChange: ({ value }) =>
                !value
                  ? "<%= f.name %>不能为空"
                  : value.length > 500
                    ? "<%= f.name %>不能超过 500 个字符"
                    : undefined,
            }}
            children={(field) => (
              <Field
                orientation="vertical"
                data-invalid={!!field.state.meta.errors.length}
              >
                <FieldLabel htmlFor="<%= f.name %>">
                  <%= f.name %>
                  <span className="ml-0.5 text-destructive">*</span>
                </FieldLabel>
                <FieldContent>
                  <Input
                    id="<%= f.name %>"
                    name="<%= f.name %>"
                    value={field.state.value}
                    placeholder="输入<%= f.name %>…"
                    aria-invalid={!!field.state.meta.errors.length}
                    onBlur={field.handleBlur}
                    onChange={(e) => field.handleChange(e.target.value)}
                  />
                  {field.state.meta.errors.length > 0 ? (
                    <FieldError
                      errors={(field.state.meta.errors as Array<string | undefined>).map(
                        (er) => ({
                          message: typeof er === "string" ? er : "格式不正确",
                        }),
                      )}
                    />
                  ) : (
                    <FieldDescription>1-500 个字符</FieldDescription>
                  )}
                </FieldContent>
              </Field>
            )}
          />
          <% } else if (f.type === "boolean") { %>
          <form.Field
            name="<%= f.name %>"
            children={(field) => (
              <Field orientation="vertical">
                <FieldLabel htmlFor="<%= f.name %>"><%= f.name %></FieldLabel>
                <FieldContent>
                  <div className="flex items-center gap-3 pt-1">
                    <Switch
                      id="<%= f.name %>"
                      checked={field.state.value}
                      onCheckedChange={(checked) => field.handleChange(checked)}
                    />
                    <FieldLabel htmlFor="<%= f.name %>" className="text-sm">
                      {field.state.value ? "是" : "否"}
                    </FieldLabel>
                  </div>
                </FieldContent>
              </Field>
            )}
          />
          <% } else if (f.type === "number") { %>
          <form.Field
            name="<%= f.name %>"
            validators={{
              onChange: ({ value }) =>
                Number.isNaN(value) ? "<%= f.name %>必须是数字" : undefined,
            }}
            children={(field) => (
              <Field
                orientation="vertical"
                data-invalid={!!field.state.meta.errors.length}
              >
                <FieldLabel htmlFor="<%= f.name %>"><%= f.name %></FieldLabel>
                <FieldContent>
                  <Input
                    id="<%= f.name %>"
                    name="<%= f.name %>"
                    type="number"
                    value={field.state.value}
                    aria-invalid={!!field.state.meta.errors.length}
                    onBlur={field.handleBlur}
                    onChange={(e) => field.handleChange(Number(e.target.value))}
                  />
                </FieldContent>
              </Field>
            )}
          />
          <% } else if (f.type === "date") { %>
          <form.Field
            name="<%= f.name %>"
            children={(field) => (
              <Field orientation="vertical">
                <FieldLabel htmlFor="<%= f.name %>"><%= f.name %></FieldLabel>
                <FieldContent>
                  <Input
                    id="<%= f.name %>"
                    name="<%= f.name %>"
                    type="date"
                    value={field.state.value}
                    onBlur={field.handleBlur}
                    onChange={(e) => field.handleChange(e.target.value)}
                  />
                </FieldContent>
              </Field>
            )}
          />
          <% } %><% }) %>
        </div>
      </FieldGroup>

      <div className="flex items-center gap-2">
        {onCancel && (
          <Button type="button" variant="outline" onClick={onCancel}>
            返回
          </Button>
        )}
        <Button type="button" variant="outline" onClick={handleReset}>
          重置
        </Button>
        <Button type="submit" disabled={isPending}>
          {isPending
            ? "保存中…"
            : defaultValues
              ? "保存修改"
              : "创建<%= title %>"}
        </Button>
      </div>
    </form>
  )
}
