import {
  pgTable,
  serial,
  timestamp,<%
%><% for (const t of ["text","boolean","number"]) { if (fields.some(f => f.type === t)) { %>
  <%= t === "number" ? "integer" : t %>,<% } } %>
} from "drizzle-orm/pg-core"
import { createInsertSchema } from "drizzle-zod"
import { createSelectSchema } from "drizzle-zod"

export const <%= name %> = pgTable("<%= name %>", {
  id: serial("id").primaryKey(),<%
%><% fields.forEach((f) => { %>
  <%= f.name %>: <%= { text: "text", boolean: "boolean", number: "integer", date: "timestamp" }[f.type] %>("<%= f.name %>").notNull()<%= f.type === "boolean" ? ".default(false)" : "" %>,<%
%><% }) %>
  createdAt: timestamp("created_at").defaultNow().notNull(),
  updatedAt: timestamp("updated_at")
    .defaultNow()
    .$onUpdate(() => new Date())
    .notNull(),
})

export const select<%= Name %>Schema = createSelectSchema(<%= name %>)

export const insert<%= Name %>Schema = createInsertSchema(<%= name %>, {<%
%><% fields.filter(f => f.type === "text").forEach((f) => { %>
  <%= f.name %>: (field) => field.min(1).max(500),<%
%><% }) %>
})
  .required({<%
%><% fields.filter(f => f.type === "boolean").forEach((f) => { %>
    <%= f.name %>: true,<%
%><% }) %>
  })
  .omit({
    id: true,
    createdAt: true,
    updatedAt: true,
  })

export const patch<%= Name %>Schema = insert<%= Name %>Schema.partial()
